---
interface Props {
    savedMsg?: string;
    errorMsg?: string;
}

const { savedMsg = "Saved", errorMsg = "Error" } = Astro.props;

const saved = Astro.url.searchParams.get("saved");
const error = Astro.url.searchParams.get("error");
---

<>
    <script>
        const removeParams = (key: string) => {
            const params = new URLSearchParams(window.location.search);

            params.delete(key);

            return params.toString();
        };

        //@ts-ignore
        if (!window.edithub) {
            //@ts-ignore
            window.edithub = {};
        }
        //@ts-ignore
        window.edithub.removeParams = removeParams;
    </script>
    {
        saved === "true" && (
            <div
                role="alert"
                class="alert alert-success mb-4"
                x-data="{ show: true }"
                x-show="show"
                x-init={`setTimeout(() => {show = false;window.history.replaceState(null,undefined,'?'+window.edithub.removeParams("saved"))}, 7000)`}
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-6 w-6 shrink-0 stroke-current"
                    fill="none"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                    />
                </svg>
                <span>{savedMsg}</span>
            </div>
        )
    }
    {
        error === "true" && (
            <div
                role="alert"
                class="alert alert-error mb-4"
                x-data="{ show: true }"
                x-show="show"
                x-init={`setTimeout(() => {show = false;window.history.replaceState(null,undefined,'?'+window.edithub.removeParams("error"))}, 7000)`}
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-6 w-6 shrink-0 stroke-current"
                    fill="none"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"
                    />
                </svg>
                <span>{errorMsg}</span>
            </div>
        )
    }
</>
