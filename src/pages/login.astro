---
import Layout from "@layouts/layout.astro";
---

<Layout>
    <div class="w-full h-full flex flex-col justify-center items-center">
        <form
            method="post"
            action="/api/login"
            class="flex flex-col gap-4 rounded-box bg-base-200 p-6 max-w-md min-w-[40%]"
        >
            <h1 class="text-3xl font-bold self-center">Log in</h1>

            <span class="self-center">
                Don't have an account?
                <a class="link link-secondary" href="/signup">Register</a>
            </span>

            <a class="btn btn-neutral" href="/api/github">
                <i class="fa-brands fa-google text-primary"></i>
                Log in with Github
            </a>

            <div class="divider">OR</div>

            <label class="form-control">
                <div class="label">
                    <span class="label-text">Email</span>
                </div>

                <input class="input input-bordered" name="email" type="email" />
            </label>

            <label class="form-control">
                <div class="label">
                    <span class="label-text">Password</span>
                    <a class="label-text link link-accent">Forgot password?</a>
                </div>

                <input
                    type="password"
                    name="password"
                    class="input input-bordered"
                />
            </label>

            <div class="form-control">
                <label class="cursor-pointer label self-start gap-2">
                    <input type="checkbox" class="checkbox" />
                    <span class="label-text">Remember me</span>
                </label>
            </div>

            <button class="btn btn-primary">Log in</button>
        </form>
    </div>
</Layout>
