---
import AccountLayout from "@layouts/accountLayout.astro";
import { GhApp } from "@lib/github";
import appRunTime from "@lib/runtime";

const user = Astro.locals.user;
const env = appRunTime(Astro).env;
const ghApp = new GhApp(
    //@ts-ignore
    user.installId,
    env,
);
const repos = await ghApp.getRepoList();
// console.log(repos);
if (Astro.request.method === "POST") {
    try {
        const data = await Astro.request.formData();
        const repo = data.get("repo");
        return Astro.redirect(`/account/repo/${repo}`);
    } catch (error) {
        if (error instanceof Error) {
            console.error(error.message);
        }
    }
}
---

<AccountLayout>
    <h2>select repo</h2>
    <form method="post">
        <select class="select select-bordered w-full max-w-xs" name="repo">
            <option disabled selected>Select repo</option>
            {repos.map((repo) => <option>{repo.name}</option>)}
        </select>
        <input type="submit" value="Select" class="btn" />
    </form>
</AccountLayout>
