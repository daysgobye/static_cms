---
import { GhApp, type FileItem } from "@lib/github";
import { getCurrentUrl, getSelectedPathParam, makeUrlSafe } from "@lib/utils";
import appRunTime from "@lib/runtime";

export const partial = true;

const newPath = getSelectedPathParam(Astro);
const user = Astro.locals.user;
const { slug } = Astro.params;
const env = appRunTime(Astro).env;
const ghApp = new GhApp(
    //@ts-ignore
    user.installId,
    env,
);

if (
    Astro.request.method === "POST" &&
    !Astro.request.headers.get("hx-request")
) {
    if (user && newPath) {
        try {
            const repo = await ghApp.getRepo(slug ? slug : "");
            const settings = await ghApp.getSettings(repo);
            if (settings === undefined) {
                return Astro.redirect(`/account/repo/${slug}/settings`);
            }
            const data = await Astro.request.formData();
            const file = data.get("upload") as string;
            const base64 = data.get("imageBase64") as string;
            const tempFilePath = `${newPath}/${file}`;

            const redirectUrl = new URL(
                `${Astro.url.origin}/account/repo/${slug}?saved=true`,
            );
            let _ = ["root", ...newPath.split("/")].forEach((part) => {
                redirectUrl.searchParams.append("path", part);
            });
            redirectUrl.searchParams.set("file", makeUrlSafe(tempFilePath));
            let fileObj: FileItem = {
                fileType: "string",
                name: file,
                path: tempFilePath,
                type: "blob",
                content: base64.split(",")[1],
            };
            await ghApp.pushFile(
                `CMS uploaded new image ${fileObj.name}`,
                user.email,
                user.name,
                fileObj,
                repo,
                true,
            );
            return Astro.redirect(redirectUrl.toString());
        } catch (error) {
            console.log("error in file upload", error);

            return Astro.redirect(
                `${Astro.url.origin}/account/repo/${slug}?error=true`,
            );
        }
    }
}
---

<>
    <h3 class="text-lg font-bold mb-4">
        Upload image to /{newPath}
    </h3>
    <form action={getCurrentUrl(Astro)} method="POST" class="flex flex-col">
        <label class="form-control w-full max-w-xs">
            <div class="label">
                <span class="label-text">Select Image file</span>
            </div>
            <input
                required
                type="file"
                class="file-input file-input-bordered w-full max-w-xs"
                name="upload"
                accept="image/*"
                x-on:change.debounce="window.edithub.fileUploadHandler($event,'imageBase64')"
            />

            <input id="imageBase64" type="hidden" name="imageBase64" />
        </label>
        <input
            class="btn btn-active btn-primary mt-4 max-w-[50%]"
            type="submit"
            value="Upload"
        />
    </form>
</>
