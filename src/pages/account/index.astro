---
import AccountLayout from "@layouts/accountLayout.astro";
import { GhApp } from "@lib/github";
import appRunTime from "@lib/runtime";

const user = Astro.locals.user;
const env = appRunTime(Astro).env;
const ghApp = new GhApp(
    //@ts-ignore
    user.installId,
    env,
);
const repos = await ghApp.getRepoList();
// console.log(repos);
if (Astro.request.method === "POST") {
    try {
        const data = await Astro.request.formData();
        const repo = data.get("repo");
        console.log("going to", repo);
        return Astro.redirect(`/account/repo/${repo}`);
    } catch (error) {
        if (error instanceof Error) {
            console.error(error.message);
        }
    }
}
---

<AccountLayout>
    <p>
        Thank you for trying our beta! Theres nothing here yet we will add
        options to manage your editor accounts here
    </p>

    <a href="/account/repo">
        <span class="flex">
            for now {" "}<h2 class="text-xl text-primary pl-2">Go Edit</h2>
        </span>
    </a>
</AccountLayout>
