---
import InstallApp from "@components/account/installApp.astro";

import SelectPlan from "@components/account/selectPlan.astro";
import UserDashboard from "@components/account/userDashboard.astro";
import Layout from "@layouts/layout.astro";
import { GhApp } from "@lib/github";

const user = Astro.locals.user;

if (user && user.installId) {
    const ghApp = new GhApp(user.installId);
    console.log(user);
    const octokit = await ghApp.app.getInstallationOctokit(user.installId);

    const repo = await ghApp.getRepo("balatzee");
    if (repo) {
        console.log("--------------------contents-------------------");
        const tree = await ghApp.getTree(repo);
        //@ts-ignore
        const file = await ghApp.getFileContent(tree.children["todo.md"], repo);
        console.log(file);
    }
} else {
    console.log("missing");
    console.log(user);
}
---

<Layout>
    {
        user && user.installId ? (
            user && user.plan ? (
                <UserDashboard />
            ) : (
                <SelectPlan />
            )
        ) : (
            <InstallApp />
        )
    }
</Layout>
