{
  "extends": "astro/tsconfigs/strict",
  "--module": "es2022",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@components/*": [
        "src/components/*"
      ],
      "@lib/*": [
        "src/lib/*"
      ],
      "@assets/*": [
        "src/assets/*"
      ],
      "@layouts/*": [
        "src/layouts/*"
      ]
    },
    "types": [
      "@cloudflare/workers-types/2023-07-01"
    ]
  }
}